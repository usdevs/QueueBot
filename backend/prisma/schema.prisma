generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          Int      @id @default(autoincrement())
  telegram_id String   @unique
  expiryDate  DateTime
}

model QueueConfig {
  id                 Int     @id @default(autoincrement())
  positionBeforePing Int
  isOpen             Boolean
  eventName          String
  venue              String
}

model Queue {
  name        String
  telegram_id String   @unique
  timeCreated DateTime
}
